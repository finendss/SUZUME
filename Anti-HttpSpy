--By芝士球工作室
local placeId=game.PlaceId
local function kickPlayer(reason)
    local player=game:GetService("Players").LocalPlayer
    if player then player:Kick(reason or "[芝士球Anti-Spy]检测到非法工具") end
end
local originalWritefile=writefile
local originalAppendfile=appendfile
local function isHttpSpyLogFile(path)
    if type(path)~="string" then return false end
    if path:match("^"..placeId.."%-%d+_%d+_%d+%-log%.txt$") then return true end
    if path:find(placeId) and path:find("log") then return true end
    if string.lower(path):find("http") and string.lower(path):find("log") then return true end
    return false
end
local function getProtectedContent()
    return "[芝士球Anti-HttpSpy] 此链接受到保护，HttpSpy 已被拦截\n游戏ID: "..placeId.."\n拦截时间: "..os.date("%Y-%m-%d %H:%M:%S").."\n日志已被保护，无法查看任何抓包数据"
end
if originalWritefile then
    writefile=function(path,content)
        if isHttpSpyLogFile(path) then
            return originalWritefile(path, getProtectedContent())
        end
        return originalWritefile(path,content)
    end
end
if originalAppendfile then
    appendfile=function(path,content)
        if isHttpSpyLogFile(path) then
            return
        end
        return originalAppendfile(path,content)
    end
end
local function overwriteExistingLog()
    local logPath = placeId .. "-" .. os.date("%d_%m_%y") .. "-log.txt"
    if originalWritefile then
        pcall(function()
            originalWritefile(logPath, getProtectedContent())
        end)
    end
end
task.spawn(overwriteExistingLog)
local SPY_VARIABLES={"HttpSpy","__KetamineShared","Ketamine","CSpy","RSpy","ESpy"}
local function isExactSpyVariable(name)
    if type(name)~="string" then return false end
    for _,spy in ipairs(SPY_VARIABLES) do
        if name==spy then return true end
    end
    return false
end
local SPY_GUI_NAMES={"HttpSpyGui","Ketamine"}
local function isSpyGuiName(name)
    if type(name)~="string" then return false end
    for _,gui in ipairs(SPY_GUI_NAMES) do
        if name==gui then return true end
    end
    return false
end
local function fullScan()
    local envs={_G}
    if getgenv then table.insert(envs,getgenv()) end
    if getfenv then table.insert(envs,getfenv()) end
    for _,env in ipairs(envs) do
        if type(env)=="table" then
            for key,_ in pairs(env) do
                if type(key)=="string" and isExactSpyVariable(key) then
                    return true
                end
            end
        end
    end
    local containers={}
    local c=game:GetService("CoreGui") if c then table.insert(containers,c) end
    local p=game:GetService("Players").LocalPlayer
    if p then local pg=p:FindFirstChild("PlayerGui") if pg then table.insert(containers,pg) end end
    if getfenv().gethui then local h=getfenv().gethui() if h and not table.find(containers,h) then table.insert(containers,h) end end
    for _,container in ipairs(containers) do
        for _,child in ipairs(container:GetChildren()) do
            if child:IsA("ScreenGui") and isSpyGuiName(child.Name) then
                return true
            end
        end
    end
    if isfunctionhooked then
        local funcs={}
        if syn and syn.request then table.insert(funcs,syn.request) end
        if http and http.request then table.insert(funcs,http.request) end
        if game and game.HttpGet then table.insert(funcs,game.HttpGet) end
        if game and game.HttpPost then table.insert(funcs,game.HttpPost) end
        for _,f in ipairs(funcs) do
            if type(f)=="function" and isfunctionhooked(f) then
                return true
            end
        end
    end
    return false
end
if fullScan() then
    kickPlayer("[芝士球Anti-Spy]检测到非法工具")
end
local envs={_G}
if getgenv then local e=getgenv() if e and e~=_G then table.insert(envs,e) end end
if getfenv then local e=getfenv() if e and e~=_G and e~=getgenv() then table.insert(envs,e) end end
local snapshots={}
for i,e in ipairs(envs) do
    local k={}
    for key,_ in pairs(e) do
        if type(key)=="string" then k[key]=true end
    end
    snapshots[i]=k
end
local containers={}
local c=game:GetService("CoreGui") if c then table.insert(containers,c) end
local p=game:GetService("Players").LocalPlayer
if p then local pg=p:FindFirstChild("PlayerGui") if pg then table.insert(containers,pg) end end
if getfenv().gethui then local h=getfenv().gethui() if h and not table.find(containers,h) then table.insert(containers,h) end end
local guiNames={}
for _,container in ipairs(containers) do
    for _,child in ipairs(container:GetChildren()) do
        if child:IsA("ScreenGui") and child.Name then guiNames[child.Name]=true end
    end
end
for _,container in ipairs(containers) do
    container.ChildAdded:Connect(function(child)
        if child:IsA("ScreenGui") and child.Name and not guiNames[child.Name] and isSpyGuiName(child.Name) then
            kickPlayer("[芝士球Anti-Spy]检测到非法工具")
        end
        guiNames[child.Name]=true
    end)
end
while true do
    for i,e in ipairs(envs) do
        local old=snapshots[i]
        for key,_ in pairs(e) do
            if type(key)=="string" and not old[key] and isExactSpyVariable(key) then
                kickPlayer("[芝士球Anti-Spy]检测到非法工具")
            end
        end
    end
    task.wait(1)
end
